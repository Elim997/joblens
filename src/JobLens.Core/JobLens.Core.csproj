<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <!-- Pin past the transitive 2.1.11 pulled in by Microsoft.Data.Sqlite: GHSA-2m69-gcr7-jv3q (bundled SQLite < 3.50.2, memory corruption). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies alongside JobLens.Core.dll and propagates to JobLens.Api/JobLens.Tests
         output dirs via ProjectReference, so POST /eval can read it at a relative path. -->
    <None Include="Eval\labeled-postings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets JobLens.Tests construct/inspect the internal tailoring-validation types directly
         (ResumeTailoringValidator, its untrusted DTOs, BaseResumeSnapshot, and
         ValidatedTailoredResume's internal constructor) without making them part of JobLens.Core's
         public API. Construction of ValidatedTailoredResume stays effectively validator-controlled:
         the only other assembly that can see the internal constructor is the test assembly. -->
    <InternalsVisibleTo Include="JobLens.Tests" />
  </ItemGroup>

</Project>
